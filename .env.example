# Copy to Vercel: Project > Settings > Environment Variables.
# Never commit real values.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Supabase > Connect > Transaction pooler (port 6543). Contains your DB password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# The one email allowed to sign in. Must match private.app_config.allowed_email.
ALLOWED_EMAIL=

# Alpaca > Paper Trading dashboard > API Keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Paper. Changing this to https://api.alpaca.markets is the only switch to live money.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Any long random string, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=
